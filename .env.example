# Sahayak - provider credentials. Copy to .env and fill in.

# --- Gemini (LLM for slot-filling) ---
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model with native JSON schema support.
GEMINI_MODEL=gemini-3.5-flash

# --- STT: local faster-whisper ---
STT_PROVIDER=local
LOCAL_STT_MODEL=large-v3-turbo
LOCAL_STT_LANGUAGE=auto
LOCAL_STT_DEVICE=auto
LOCAL_STT_COMPUTE_TYPE=int8_float16
LOCAL_STT_CPU_THREADS=4

# --- TTS: edge-tts (Microsoft) ---
TTS_PROVIDER=edge
EDGE_TTS_VOICE=hi-IN-SwaraNeural

# --- CPGRAMS (RPA filing; bridge until real API access) ---
# Register once manually on https://pgportal.gov.in (needs CAPTCHA + OTP),
# then supply login credentials here for the automation.
CPGRAMS_EMAIL=
CPGRAMS_PASSWORD=

# --- RPA session linking (persisted, encrypted-at-rest) ---
# Generate: python -m app.rpa.session_store --gen-key
# NEVER store citizens' CPGRAMS passwords. We persist an *authenticated session*
# encrypted with this key, short-lived (TTL), and auto-invalidated on expiry.
SAHAYAK_SESSION_ENCRYPTION_KEY=
# How long a linked session is trusted before a re-link is required.
SAHAYAK_SESSION_TTL_HOURS=24
# Account key used by the API filing endpoint until per-citizen identity exists.
SAHAYAK_DEFAULT_ACCOUNT=default
